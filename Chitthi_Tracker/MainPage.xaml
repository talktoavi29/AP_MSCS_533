<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Chitthi_Tracker.MainPage"
             Title="Location Heat Map">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12">
        <HorizontalStackLayout Spacing="10">
            <Button x:Name="StartBtn" Text="Start" Clicked="StartClicked"/>
            <Button x:Name="StopBtn" Text="Stop" Clicked="StopClicked" IsEnabled="False"/>
            <Button Text="Show History" Clicked="ShowHistoryClicked"/>
        </HorizontalStackLayout>

        <maps:Map x:Name="MyMap" Grid.Row="1"
                  MapType="Street"
                  IsShowingUser="True" />

        <Label x:Name="StatusLbl" Grid.Row="2" FontSize="12"
               TextColor="Gray"
               Text="Ready."/>
    </Grid>
</ContentPage>